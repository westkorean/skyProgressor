{
  "name": "skyprogressor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --no-warnings --experimental-strip-types --test tests/*.test.ts",
    "update:pet-textures": "tsx scripts/updatePetTextures.ts && tsx scripts/importPetCatalog.ts && tsx scripts/generatePetHeadImages.ts",
    "update:pet-items": "tsx scripts/updatePetItems.ts",
    "update:collections": "tsx scripts/updateCollections.ts",
    "update:minions": "tsx scripts/updateMinions.ts",
    "update:bestiary": "tsx scripts/updateBestiary.ts",
    "update:museum": "tsx scripts/updateMuseumCatalog.ts",
    "update:item-recipes": "tsx scripts/updateItemRecipes.ts",
    "validate:data": "node --no-warnings --experimental-strip-types scripts/validateGeneratedData.ts",
    "validate:knowledge": "node --no-warnings --experimental-strip-types scripts/validateKnowledge.ts",
    "update:knowledge": "node --no-warnings --experimental-strip-types scripts/updateKnowledge.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.20",
    "@ai-sdk/react": "^4.0.40",
    "@fontsource-variable/pixelify-sans": "^5.3.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.37",
    "fflate": "^0.8.3",
    "next": "16.2.10",
    "openai": "^6.48.0",
    "prismarine-nbt": "^2.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "sharp": "^0.35.0",
    "skyhelper-networth": "^2.8.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.21",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.3",
    "typescript": "^5"
  },
  "overrides": {
    "sharp": "^0.35.0"
  }
